<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field
            name="name"
        >res.config.settings.view.form.inherit.maintenance.done.readonly</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="maintenance.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//app[@name='maintenance']" position="inside">
                <block title="Completed Requests" id="maintenance_done_readonly_block">
                    <setting
                        help="Fields that non-managers may still edit after a request is completed. Every other field becomes read-only once the request is done."
                    >
                        <field
                            name="maintenance_done_editable_field_ids"
                            widget="many2many_tags"
                        />
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
