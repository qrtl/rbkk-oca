<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t
        t-name="base_import_match.ImportDataContent"
        t-inherit="ImportDataContent"
        t-inherit-mode="extension"
    >
        <xpath expr="//th[text()='Comments']" position="before">
            <th
                scope="col"
                class="text-nowrap"
                style="min-width: 0 !important; width: auto;"
            >Match Only</th>
        </xpath>
        <xpath
            expr="//td[.//ImportDataColumnError or .//ImportDataOptions or .//t[@t-foreach='column.comments']]"
            position="before"
        >
            <td class="text-center">
                <input
                    type="checkbox"
                    class="form-check-input"
                    t-att-checked="column.matchOnly"
                    t-att-disabled="!column.fieldInfo"
                    t-on-change="(ev) => this.onMatchOnlyChanged(column, ev)"
                />
            </td>
        </xpath>
    </t>
</templates>
