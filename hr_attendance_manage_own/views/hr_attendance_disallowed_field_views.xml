<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="hr_attendance_disallowed_field_view_tree" model="ir.ui.view">
        <field name="name">hr.attendance.disallowed.field.tree</field>
        <field name="model">hr.attendance.disallowed.field</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="field_id" />
                <field name="field_name" optional="show" />
            </list>
        </field>
    </record>
    <record id="hr_attendance_disallowed_field_action" model="ir.actions.act_window">
        <field name="name">Disallowed Fields</field>
        <field name="res_model">hr.attendance.disallowed.field</field>
        <field name="view_mode">list</field>
    </record>
    <menuitem
        id="menu_hr_attendance_disallowed_field"
        name="Disallowed Fields"
        parent="hr_attendance.menu_hr_attendance_root"
        action="hr_attendance_disallowed_field_action"
        sequence="20"
        groups="hr_attendance.group_hr_attendance_manager"
    />
</odoo>
